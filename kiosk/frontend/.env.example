# Kiosk frontend configuration. Copy to .env.local (git-ignored) and fill in.
#
# The kiosk always talks to the real Django API — there is no in-browser substitute — so
# the backend must be running before the auth screens will work:
#
#   docker compose up -d db redis
#   cd backend && uv run python manage.py migrate && uv run python manage.py runserver
#   uv run python manage.py provision_terminal --name "Demo Kiosk"   # prints the secret ONCE

# ---------------------------------------------------------------------------
# Client-visible. Anything prefixed VITE_ is compiled into the browser bundle,
# so never put a secret here.
# ---------------------------------------------------------------------------

# Relative on purpose: the dev proxy and nginx both mount the backend at /api,
# so no backend origin is baked into the bundle.
VITE_API_BASE_URL=/api/v1

VITE_API_TIMEOUT_MS=12000

# FR-33's QR fast path needs the optional scanner peripheral. Off by default.
VITE_AUTH_QR_ENABLED=false

# ---------------------------------------------------------------------------
# Server-side only. No VITE_ prefix, so these are read by vite.config.ts in Node
# and never reach the browser.
# ---------------------------------------------------------------------------

KIOSK_API_ORIGIN=http://127.0.0.1:8000

# Every /api/v1/auth/kiosk/* call needs an X-Terminal-Key header identifying this
# physical kiosk. The backend's Terminal model forbids provisioning this secret into
# browser JavaScript, so the dev proxy injects it (nginx does the same in production
# via TERMINAL_KEY). Without it every auth screen shows "Sign-in unavailable".
KIOSK_TERMINAL_KEY=
