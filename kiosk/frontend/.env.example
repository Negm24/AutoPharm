# Kiosk frontend configuration. Copy to .env.local (git-ignored) and adjust.

# ---------------------------------------------------------------------------
# Client-visible. Anything prefixed VITE_ is compiled into the browser bundle,
# so never put a secret here.
# ---------------------------------------------------------------------------

# Relative on purpose: the dev proxy and nginx both mount the backend at /api,
# so no backend origin is baked into the bundle.
VITE_API_BASE_URL=/api/v1

VITE_API_TIMEOUT_MS=12000

# 'mock' runs the whole auth flow in the browser against a faithful replica of the
# backend rules. 'http' talks to the real /api/v1/auth/kiosk/* endpoints, which also
# needs Postgres, Redis and a provisioned Terminal row.
VITE_AUTH_GATEWAY=mock

# FR-33's QR fast path needs the optional scanner peripheral. Off by default.
VITE_AUTH_QR_ENABLED=false

# ---------------------------------------------------------------------------
# Server-side only. No VITE_ prefix, so these are read by vite.config.ts in Node
# and never reach the browser.
# ---------------------------------------------------------------------------

KIOSK_API_ORIGIN=http://127.0.0.1:8000

# Every /api/v1/auth/kiosk/* call needs an X-Terminal-Key header. The Terminal model
# forbids provisioning this secret into browser JavaScript, so the dev proxy injects it
# (nginx does the same in production). Create the matching row with:
#   Terminal.objects.create(name='Kiosk 04', key_hash=sha256(key.encode()).hexdigest())
KIOSK_TERMINAL_KEY=
